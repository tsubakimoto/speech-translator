<Page x:Class="SpeechTranslatorWinUI.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
  <TextBlock Text="Azure Speech 設定" Style="{ThemeResource TitleTextBlockStyle}"/>
  <TextBlock Text="API キーは現在の Windows ユーザーで暗号化され、このアプリ専用のデータベースに保存されます。WPF の設定は読み込みません。" TextWrapping="Wrap"/>
  <TextBox Header="リージョン" PlaceholderText="japaneast" AutomationProperties.AutomationId="SpeechRegionTextBox" Text="{x:Bind ViewModel.Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind CanEditDraft, Mode=OneWay}"/>
  <PasswordBox Header="API キー" AutomationProperties.AutomationId="SpeechApiKeyPasswordBox" Password="{x:Bind ViewModel.Key, Mode=TwoWay}" IsEnabled="{x:Bind CanEditDraft, Mode=OneWay}"/>
  <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="保存" AutomationProperties.AutomationId="SaveSpeechSettingsButton" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Click="SaveAsync" Style="{ThemeResource AccentButtonStyle}"/><Button Content="変更を破棄" AutomationProperties.AutomationId="DiscardSpeechSettingsButton" IsEnabled="{x:Bind CanEditDraft, Mode=OneWay}" Click="Cancel"/><Button Content="設定を復旧…" AutomationProperties.AutomationId="RecoverSpeechSettingsButton" IsEnabled="{x:Bind CanRecover, Mode=OneWay}" Click="RecoverAsync"/></StackPanel>
  <TextBlock Text="{x:Bind ViewModel.SettingsMessage, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="翻訳中・停止中・停止失敗後は編集できません。未保存の変更を残してページを離れる場合は確認します。記録名が空ならファイルへの記録は行いません。" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</Page>

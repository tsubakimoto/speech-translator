<Page x:Class="Tsubakimoto.SpeechTranslator.WinUIApp.TranslationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:Tsubakimoto.SpeechTranslator.WinUIApp.Core">
 <Grid Padding="24" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
  <StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="16">
   <ComboBox x:Name="SourceLanguage" Header="認識言語" AutomationProperties.AutomationId="SourceLanguageCombo" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Source, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" SelectionChanged="LanguageChangedAsync"><ComboBoxItem Content="English (en-US)" Tag="en-US"/><ComboBoxItem Content="日本語 (ja-JP)" Tag="ja-JP"/></ComboBox>
   <ComboBox x:Name="TargetLanguage" Header="翻訳言語" AutomationProperties.AutomationId="TargetLanguageCombo" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Target, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" SelectionChanged="LanguageChangedAsync"><ComboBoxItem Content="English (en-US)" Tag="en-US"/><ComboBoxItem Content="日本語 (ja-JP)" Tag="ja-JP"/></ComboBox>
  </StackPanel>
   <TextBox Header="記録ファイル名（任意・拡張子なし）" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RecordingFilenameTextBox" Text="{x:Bind ViewModel.Filename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Spacing="12"><Button Content="記録フォルダーを選択" AutomationProperties.AutomationId="ChooseRecordingFolderButton" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Click="SelectFolderAsync"/><TextBlock Text="{x:Bind ViewModel.Folder, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.SettingsMessage, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"><Button Content="翻訳を開始" AutomationProperties.AutomationId="StartTranslationButton" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Click="StartAsync" Style="{ThemeResource AccentButtonStyle}"/><Button Content="停止 / 再試行" AutomationProperties.AutomationId="StopTranslationButton" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" Click="StopAsync"/><TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Grid Grid.Row="3" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="原文" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Grid.Column="1" Text="翻訳" Style="{ThemeResource SubtitleTextBlockStyle}"/></Grid>
  <ListView x:Name="Results" Grid.Row="4" ItemsSource="{x:Bind ViewModel.Translations, Mode=OneWay}" SelectionMode="None" AutomationProperties.AutomationId="TranslationResultsList" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="core:Translation"><Grid ColumnSpacing="16" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind SourceText, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Grid.Column="1" Text="{x:Bind TranslatedText, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
  <TextBlock Grid.Row="5" Text="アクティビティ" Style="{ThemeResource SubtitleTextBlockStyle}"/>
  <ListView x:Name="Activity" Grid.Row="6" ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}" SelectionMode="None" AutomationProperties.AutomationId="ActivityLogList" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></DataTemplate></ListView.ItemTemplate></ListView>
 </Grid>
</Page>
